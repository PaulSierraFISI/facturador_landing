---
import { waHref } from '../config';
---
<footer style="background:var(--ink);color:#fff;padding:clamp(48px,6vw,72px) var(--pad) 40px;">
    <div style="max-width:1240px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:36px 32px;">
      <div style="min-width:0;">
        <div style="display:flex;align-items:center;gap:9px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4.6 2h9.1L21 9.3v11.1c0 .9-.7 1.6-1.6 1.6H4.6c-.9 0-1.6-.7-1.6-1.6V3.6C3 2.7 3.7 2 4.6 2Z" fill="#6C63FF"></path><path d="M13.7 2 21 9.3h-5.7c-.9 0-1.6-.7-1.6-1.6V2Z" fill="#B9B4FF"></path></svg>
          <span style="font-size:22px;font-weight:800;letter-spacing:-.03em;color:#fff;">ruckia</span>
        </div>
        <p style="margin-top:14px;font-size:15px;line-height:1.55;color:#A1A1AA;max-width:24em;">Facturación electrónica para micro y pequeños negocios en Perú. Nosotros nos encargamos de la parte técnica.</p>
      </div>
      <div style="min-width:0;">
        <p style="font-size:12.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#71717A;">Producto</p>
        <ul style="margin-top:16px;display:grid;gap:11px;">
          <li><a href="/#beneficios" style="font-size:15px;color:#D4D4D8;" data-hover="h5">Beneficios</a></li>
          <li><a href="/#como-funciona" style="font-size:15px;color:#D4D4D8;" data-hover="h5">Cómo funciona</a></li>
          <li><a href="/#precios" style="font-size:15px;color:#D4D4D8;" data-hover="h5">Precios</a></li>
        </ul>
      </div>
      <div style="min-width:0;">
        <p style="font-size:12.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#71717A;">Ayuda</p>
        <ul style="margin-top:16px;display:grid;gap:11px;">
          <li><a href="/#faq" style="font-size:15px;color:#D4D4D8;" data-hover="h5">Preguntas frecuentes</a></li>
          <li><a href={waHref} target="_blank" rel="noopener" style="font-size:15px;color:#D4D4D8;" data-hover="h5">Escríbenos por WhatsApp</a></li>
          <li><a href={waHref} target="_blank" rel="noopener" style="font-size:15px;color:#D4D4D8;" data-hover="h5">+51 973 229 360</a></li>
        </ul>
      </div>
    </div>
    <div style="max-width:1240px;margin:36px auto 0;padding-top:24px;border-top:1px solid #3F3F46;display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between;font-size:13.5px;color:#71717A;">
      <span>© 2026 Ruckia. Todos los derechos reservados.</span>
      <span>Hecho en Perú</span>
    </div>
  </footer>
